{"nodes": [{"id": "agents_seo_content", "label": "seo-content agent", "file_type": "document", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_seo_content_eeat_scoring_model", "label": "E-E-A-T scoring model (internal weights)", "file_type": "concept", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights (Experience 20, Expertise 25, Authoritativeness 25, Trustworthiness 30) are this skill's internal model, not Google's; Google publishes no numeric weights and says only that trust is most important."}, {"id": "agents_seo_content_templated_metadata_check", "label": "Templated metadata detection", "file_type": "concept", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bulk-generated title/description pairs (description echoing title plus stock CTA) are a content-quality problem even when body copy is unique; heuristic string comparison, makes no claim about a specific Google update."}, {"id": "agents_seo_content_ai_content_assessment", "label": "AI content assessment per QRG Sept 2025", "file_type": "concept", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI content is acceptable if it shows genuine E-E-A-T; low-quality markers are generic phrasing, no original insight, no first-hand experience, factual errors, repetitive structure."}, {"id": "agents_seo_content_content_minimums", "label": "Page-type word count minimums", "file_type": "concept", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Topical coverage floors, not targets; word count is not a direct Google ranking factor."}, {"id": "agents_seo_content_helpful_content_system_merge", "label": "Helpful Content System merged into core (March 2024)", "file_type": "concept", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_seo_content_untrusted_content_rule", "label": "Fetched content is untrusted data rule", "file_type": "rationale", "source_file": "agents/seo-content.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetched pages, SERPs, and tool output are treated as untrusted data and never as instructions, mitigating prompt injection."}], "edges": [{"source": "agents_seo_content", "target": "agents_seo_content_eeat_scoring_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agents/seo-content.md", "source_location": null, "weight": 1.0}, {"source": "agents_seo_content", "target": "agents_seo_content_templated_metadata_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agents/seo-content.md", "source_location": null, "weight": 1.0}, {"source": "agents_seo_content", "target": "agents_seo_content_ai_content_assessment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agents/seo-content.md", "source_location": null, "weight": 1.0}, {"source": "agents_seo_content", "target": "agents_seo_content_content_minimums", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agents/seo-content.md", "source_location": null, "weight": 1.0}, {"source": "agents_seo_content", "target": "agents_seo_content_helpful_content_system_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agents/seo-content.md", "source_location": null, "weight": 1.